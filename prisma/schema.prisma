// Prisma schema for Discord Security Bot
// SQLite in development, PostgreSQL-compatible for production
// Switch DATABASE_URL in .env to use PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Guild
// ============================================================
model Guild {
  id        String   @id           // Discord guild snowflake ID
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config           GuildConfig?
  whitelistEntries WhitelistEntry[]
  securityEvents   SecurityEvent[]
  moderationCases  ModerationCase[]
  giveaways        Giveaway[]
  tickets          Ticket[]
}

// ============================================================
// Guild Configuration
// ============================================================
model GuildConfig {
  id      String @id @default(cuid())
  guildId String @unique

  // Anti-Raid
  antiraidEnabled Boolean @default(false)
  antiraidLevel   String  @default("MEDIUM") // LOW | MEDIUM | HIGH | EXTREME

  // Anti-Nuke
  antinukeEnabled Boolean @default(false)

  // Logging
  logChannelId String?

  // Welcome
  welcomeChannelId String?

  // Lockdown
  lockdownActive Boolean @default(false)

  // Thresholds (stored as JSON strings for SQLite compatibility)
  raidThresholds     String @default("{\"joins10s\":10,\"joins30s\":20,\"joins2m\":50,\"newAccountAgeDays\":7,\"mentionSpamCount\":10}")
  antinukeThresholds String @default("{\"channelDelete\":5,\"channelCreate\":5,\"roleDelete\":5,\"roleCreate\":5,\"banCount\":5,\"kickCount\":5,\"webhookCreate\":3,\"windowSeconds\":10}")

  // Moderation settings
  moderationSettings String @default("{\"dmOnPunish\":true,\"deleteCommandMessages\":false}")

  // Lockdown settings
  lockdownSettings String @default("{\"denySendMessages\":true,\"denyAddReactions\":false}")

  // Bot activity (global, set by owners only)
  botActivity String? // JSON: { type, name, url? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// ============================================================
// Bot Owners
// ============================================================
model BotOwner {
  id      String   @id @default(cuid())
  userId  String   @unique
  addedBy String   // User ID of who added this owner
  addedAt DateTime @default(now())
}

// ============================================================
// Whitelist
// ============================================================
model WhitelistEntry {
  id       String   @id @default(cuid())
  guildId  String
  targetId String   // Discord user/role/bot ID
  type     String   // USER | ROLE | BOT
  addedBy  String   // User ID
  addedAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, targetId])
}

// ============================================================
// Security Events
// ============================================================
model SecurityEvent {
  id       String   @id @default(cuid())
  guildId  String
  type     String   // RAID_DETECTED | NUKE_DETECTED | etc.
  severity String   // INFO | LOW | MEDIUM | HIGH | CRITICAL
  actorId  String?  // Discord user ID who triggered the event
  targetId String?  // Discord user/channel/role ID affected
  action   String   // Action taken description
  details  String   // JSON string with additional details
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, type])
}

// ============================================================
// Moderation Cases
// ============================================================
model ModerationCase {
  id           String   @id @default(cuid())
  caseNumber   Int      // Auto-incrementing per guild
  guildId      String
  type         String   // BAN | KICK | TIMEOUT | WARN | UNBAN | UNTIMEOUT | CLEAR | LOCK | UNLOCK
  targetId     String
  targetTag    String   // username#discriminator snapshot
  moderatorId  String
  moderatorTag String
  reason       String?
  duration     Int?     // Timeout duration in ms
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, targetId])
  @@index([guildId, caseNumber])
}

// ============================================================
// Auto-Role
// ============================================================
model AutoRole {
  id      String @id @default(cuid())
  guildId String
  roleId  String
  addedAt DateTime @default(now())

  @@unique([guildId, roleId])
}

// ============================================================
// Invite Tracker
// ============================================================
model InviteData {
  id         String   @id @default(cuid())
  guildId    String
  inviteCode String
  inviterId  String   // Discord user ID who created the invite
  uses       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guildId, inviteCode])
  @@index([guildId, inviterId])
}

model InviteJoin {
  id          String   @id @default(cuid())
  guildId     String
  joinerId    String   // The user who joined
  inviterId   String   // The user whose invite was used
  inviteCode  String
  joinedAt    DateTime @default(now())

  @@index([guildId, inviterId])
  @@index([guildId, joinerId])
}

// ============================================================
// OAuth Sessions (Dashboard)
// ============================================================
model OAuthSession {
  id           String   @id @default(cuid())
  userId       String
  accessToken  String
  refreshToken String?
  tokenType    String   @default("Bearer")
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// Giveaways
// ============================================================
model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?  @unique
  hostId      String
  prize       String
  winnerCount Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  cancelled   Boolean  @default(false)
  winnerIds   String   @default("[]")
  createdAt   DateTime @default(now())

  guild   Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries GiveawayEntry[]

  @@index([guildId, ended])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  messageId  String
  userId     String
  enteredAt  DateTime @default(now())

  giveaway Giveaway @relation(fields: [messageId], references: [messageId])

  @@unique([messageId, userId])
  @@index([messageId])
}

// ============================================================
// XP / Levels
// ============================================================
model UserLevel {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  messages  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

model LevelConfig {
  id               String  @id @default(cuid())
  guildId          String  @unique
  enabled          Boolean @default(true)
  xpPerMessage     Int     @default(15)
  xpCooldownSecs   Int     @default(60)
  levelUpChannelId String?
  levelRoles       String  @default("[]") // JSON: [{level: N, roleId: "..."}]
  excludedChannels String  @default("[]") // JSON array of channel IDs
  excludedRoles    String  @default("[]") // JSON array of role IDs
}

// ============================================================
// Tickets
// ============================================================
model Ticket {
  id        String    @id @default(cuid())
  guildId   String
  channelId String    @unique
  userId    String
  number    Int
  subject   String?
  status    String    @default("OPEN") // OPEN | CLOSED
  claimedBy String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, userId])
}

model TicketConfig {
  id             String  @id @default(cuid())
  guildId        String  @unique
  enabled        Boolean @default(false)
  categoryId     String?
  supportRoleId  String?
  logChannelId   String?
  maxOpenPerUser Int     @default(1)
}

// ============================================================
// Verification
// ============================================================
model VerificationConfig {
  id                    String  @id @default(cuid())
  guildId               String  @unique
  enabled               Boolean @default(false)
  verificationChannelId String?  // channel where verify button is posted
  verifiedRoleId        String?  // role assigned after verification
  pendingRoleId         String?  // optional role given before verification
  useModal              Boolean @default(true) // ask a math question via modal
}

model VerificationPending {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  question  String   // the math question displayed to the user
  answer    String   // expected answer to the math question
  createdAt DateTime @default(now())
  expiresAt DateTime // kick if not verified by this time

  @@unique([guildId, userId])
  @@index([guildId])
}
