{
  "name": "discord-security-bot",
  "version": "1.0.0",
  "description": "Professional Discord Security Bot with Anti-Raid, Anti-Nuke, Moderation and Web Dashboard",
  "main": "dist/bot/index.js",
  "scripts": {
    "dev": "tsx watch src/bot/index.ts",
    "build": "prisma generate && prisma db push --accept-data-loss",
    "start": "tsx src/bot/index.ts",
    "deploy": "tsx src/bot/deploy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "dashboard:dev": "tsx watch dashboard/backend/src/server.ts",
    "dashboard:build": "tsc --project dashboard/backend/tsconfig.json",
    "dashboard:start": "node dist/dashboard/backend/server.js"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "@discordjs/rest": "^2.3.0",
    "@discordjs/builders": "^1.8.2",
    "discord-api-types": "^0.37.83",
    "@prisma/client": "^5.10.2",
    "zod": "^3.22.4",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "csurf": "^1.11.0",
    "winston": "^3.11.0",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "tsx": "^4.7.1",
    "prisma": "^5.10.2",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "supertest": "^6.3.4",
    "@types/node": "^20.11.28",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
