# ============================================================
# DISCORD BOT
# ============================================================
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your application/client ID
CLIENT_ID=

# Your application client secret (for OAuth2)
CLIENT_SECRET=

# Comma-separated list of Discord user IDs that are bot owners
# Example: OWNER_IDS=123456789,987654321
OWNER_IDS=

# ============================================================
# DATABASE
# ============================================================
# SQLite (development): file:./prisma/dev.db
# PostgreSQL (production): postgresql://user:pass@host:5432/db
DATABASE_URL=file:./prisma/dev.db

# ============================================================
# DASHBOARD
# ============================================================
# Strong random secret for signing cookies (min 32 chars)
SESSION_SECRET=

# Full URL where Discord should redirect after OAuth2 login
# Development: http://localhost:3001/auth/callback
# Production: https://yourdomain.com/auth/callback
OAUTH2_REDIRECT_URI=http://localhost:3001/auth/callback

# Port for the dashboard backend API
DASHBOARD_PORT=3001

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# ============================================================
# ENVIRONMENT
# ============================================================
# development | production
NODE_ENV=development
